<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Roland RNG - Project Moon Edition</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Pretendard', -apple-system, sans-serif; user-select: none; -webkit-tap-highlight-color: transparent; }
        
        body {
            width: 100vw; height: 100vh; overflow: hidden;
            background: #050508; color: white;
            display: flex; flex-direction: column; justify-content: space-between; align-items: center;
            padding: 20px; position: relative;
        }

        #aura-canvas-container {
            position: absolute; top: 38%; left: 50%;
            transform: translate(-50%, -50%);
            width: 500px; height: 500px;
            pointer-events: none; z-index: 2;
            display: flex; justify-content: center; align-items: center;
        }

        canvas { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }

        #character-avatar {
            width: 60px; height: 60px; background: #ffffff;
            border-radius: 50%; z-index: 5;
            box-shadow: 0 0 35px rgba(255, 255, 255, 0.9); transition: all 0.5s ease;
        }

        .top-bar {
            z-index: 10; display: flex; gap: 15px; background: rgba(15, 15, 25, 0.85);
            padding: 12px 24px; border-radius: 30px; border: 1px solid #333;
            backdrop-filter: blur(10px); flex-wrap: wrap; justify-content: center; max-width: 90%;
        }
        .stat-item { font-size: 14px; font-weight: bold; }
        .stat-val { color: #00ffcc; }

        .main-display {
            z-index: 10; text-align: center; display: flex; flex-direction: column;
            align-items: center; justify-content: center; margin-top: 250px;
        }
        .aura-title {
            font-size: 42px; font-weight: 900; letter-spacing: 2px;
            margin-bottom: 8px; text-shadow: 0 0 25px currentColor;
            transition: transform 0.15s ease; word-break: keep-all;
        }
        .aura-rarity {
            font-size: 18px; font-weight: 700; color: #aaa;
            background: rgba(0, 0, 0, 0.75); padding: 6px 20px; border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.15); backdrop-filter: blur(5px);
        }

        .control-panel {
            z-index: 10; display: flex; flex-direction: column; align-items: center; gap: 12px;
            margin-bottom: 15px; width: 100%; max-width: 480px;
        }
        .roll-btn {
            background: linear-gradient(135deg, #2b2b3d, #151522);
            color: #fff; border: 2px solid #00ffcc; padding: 18px 55px;
            font-size: 26px; font-weight: 900; border-radius: 50px; cursor: pointer;
            box-shadow: 0 0 25px rgba(0, 255, 204, 0.3); transition: all 0.1s; width: 100%;
        }
        .roll-btn:active { transform: scale(0.95); }
        .roll-btn:disabled { opacity: 0.5; cursor: not-allowed; border-color: #555; box-shadow: none; }

        .btn-group { display: flex; gap: 10px; width: 100%; justify-content: center; }
        .sub-btn {
            background: rgba(25, 25, 40, 0.85); color: #ccc; border: 1px solid #444;
            padding: 10px 16px; border-radius: 20px; font-size: 13px; cursor: pointer;
            font-weight: bold; transition: 0.2s; flex: 1; text-align: center;
        }
        .sub-btn.active { background: #00ffcc; color: #000; border-color: #00ffcc; }

        #inspect-panel {
            display: none; z-index: 10; flex-direction: column; align-items: center; gap: 10px;
            margin-bottom: 25px; width: 100%; max-width: 480px;
        }
        .exit-btn {
            background: linear-gradient(135deg, #cc0000, #660000);
            color: #fff; border: 2px solid #ff4d4d; padding: 16px 50px;
            font-size: 22px; font-weight: 900; border-radius: 50px; cursor: pointer;
            box-shadow: 0 0 20px rgba(255, 77, 77, 0.4); transition: all 0.1s; width: 100%;
        }
        .exit-btn:active { transform: scale(0.95); }

        .modal {
            display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
            background: rgba(0, 0, 0, 0.85); z-index: 999; justify-content: center; align-items: center;
        }
        .modal-content {
            background: #12121c; border: 1px solid #333; width: 90%; max-width: 520px;
            border-radius: 20px; padding: 25px; max-height: 80vh; overflow-y: auto;
        }
        .modal-title { font-size: 20px; font-weight: bold; margin-bottom: 15px; text-align: center; color: #00ffcc; }
        .item-row { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid #222; font-size: 14px; }
        .view-btn {
            background: rgba(0, 255, 204, 0.15); color: #00ffcc; border: 1px solid #00ffcc;
            padding: 6px 12px; border-radius: 12px; font-size: 12px; cursor: pointer; font-weight: bold;
        }
        .view-btn:hover { background: #00ffcc; color: #000; }
        .craft-card { background: #1a1a28; border: 1px solid #333; border-radius: 12px; padding: 12px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; }
        .craft-info { display: flex; flex-direction: column; gap: 4px; }
        .craft-req { font-size: 11px; color: #aaa; }

        @media (max-width: 768px) {
            body { padding: 12px; }
            #aura-canvas-container { width: 340px; height: 340px; top: 34%; }
            #character-avatar { width: 46px; height: 46px; }
            .top-bar { padding: 8px 14px; gap: 8px 12px; border-radius: 18px; font-size: 12px; }
            .stat-item { font-size: 12px; }
            .main-display { margin-top: 180px; }
            .aura-title { font-size: 28px; }
            .aura-rarity { font-size: 14px; padding: 4px 14px; }
            .control-panel { gap: 8px; margin-bottom: 10px; }
            .roll-btn { padding: 15px 0; font-size: 22px; border-radius: 30px; }
            .sub-btn { padding: 10px 4px; font-size: 11px; border-radius: 14px; }
            .exit-btn { padding: 14px 0; font-size: 18px; }
            .modal-content { width: 95%; padding: 18px; max-height: 85vh; }
        }
    </style>
</head>
<body>

    <div id="aura-canvas-container">
        <canvas id="auraCanvas" width="500" height="500"></canvas>
        <div id="character-avatar"></div>
    </div>

    <div class="top-bar">
        <div class="stat-item">총 ROLL: <span id="total-rolls" class="stat-val">0</span>회</div>
        <div class="stat-item">안젤리카의 유산: <span id="gold-val" class="stat-val" style="color:#ffd700;">0</span> G</div>
        <div class="stat-item">공명 배율: <span id="luck-mult" class="stat-val">1.0x</span></div>
        <div class="stat-item">최고 도달: <span id="best-roll" class="stat-val">None</span></div>
    </div>

    <div class="main-display">
        <div id="aura-name" class="aura-title" style="color: #888;">ROLL을 눌러주세요</div>
        <div id="aura-rarity" class="aura-rarity">1 / 1</div>
    </div>

    <div id="normal-panel" class="control-panel">
        <button id="roll-btn" class="roll-btn">ROLL (도서관 추출)</button>
        <div class="btn-group">
            <button id="auto-btn" class="sub-btn">Auto: OFF</button>
            <button id="shop-btn" class="sub-btn">🧪 뇌혈관 상점</button>
            <button id="inv-btn" class="sub-btn">📖 도감</button>
        </div>
    </div>

    <div id="inspect-panel">
        <button id="exit-inspect-btn" class="exit-btn">🚪 구경 종료 (돌아가기)</button>
    </div>

    <div id="inv-modal" class="modal">
        <div class="modal-content">
            <div class="modal-title">📖 도서관 책장 수집 도감 (30종)</div>
            <div id="inv-list"></div>
            <button id="close-inv" class="sub-btn" style="width:100%; margin-top:15px; padding: 12px 0;">닫기</button>
        </div>
    </div>

    <div id="shop-modal" class="modal">
        <div class="modal-content">
            <div class="modal-title">🧪 엔케팔린 물약 연금소</div>
            <div class="craft-card">
                <div class="craft-info">
                    <strong>엔케팔린 샷 (+2x 공명 / 15초)</strong>
                    <span class="craft-req">비용: 100 G</span>
                </div>
                <button class="sub-btn" onclick="buyPotion('small')">추출</button>
            </div>
            <div class="craft-card">
                <div class="craft-info">
                    <strong>정제된 뇌수 (+5x 공명 / 20초)</strong>
                    <span class="craft-req">재료: 500 G + 단악수선 1개</span>
                </div>
                <button class="sub-btn" onclick="craftPotion('large')">제작</button>
            </div>
            <div class="craft-card">
                <div class="craft-info">
                    <strong>빛의 물결 (Auto 속도 3배 / 20초)</strong>
                    <span class="craft-req">재료: 1,000 G + 눈의 여왕 1개</span>
                </div>
                <button class="sub-btn" onclick="craftPotion('speed')">제작</button>
            </div>
            <div class="craft-card">
                <div class="craft-info">
                    <strong>검은침묵의 가호 (+20x 공명 / 10초)</strong>
                    <span class="craft-req">재료: 5,000 G + 알리우네 1개</span>
                </div>
                <button class="sub-btn" onclick="craftPotion('hyper')">제작</button>
            </div>
            <button id="close-shop" class="sub-btn" style="width:100%; margin-top:15px; padding: 12px 0;">닫기</button>
        </div>
    </div>

    <script>
        // 프로젝트 문 전체 기믹 / 환상체 / 책장 등급표
        const AURAS = [
            { name: "쥐", chance: 2, color: "#888888", effect: "dust" },
            { name: "9급 해결사", chance: 4, color: "#a0a0ff", effect: "holyCross" },
            { name: "8급 해결사", chance: 8, color: "#ff88cc", effect: "leaf" },
            { name: "엄지 산하 : 흑운회", chance: 16, color: "#00ccff", effect: "orbitDots" },
            { name: "7급 해결사", chance: 32, color: "#88ffff", effect: "snowBurst" },
            { name: "6급 해결사", chance: 64, color: "#ff66cc", effect: "sparkle" },
            { name: "츠바이 협회 : 5과", chance: 128, color: "#4488ff", effect: "crystalShard" },
            { name: "5급 해결사", chance: 256, color: "#ffaa00", effect: "goldenBeam" },
            { name: "4급 해결사", chance: 500, color: "#ff3333", effect: "fireFlame" },
            { name: "3급 해결사", chance: 1024, color: "#cccccc", effect: "floatCircle" },
            { name: "2급 해결사", chance: 2500, color: "#222222", effect: "demonHellfire" },
            { name: "1급 해결사", chance: 5000, color: "#00ffff", effect: "swirlVortex" },
            { name: "느티나무 공방 : 메이스", chance: 20000, color: "#ff0000", effect: "pixelNoise" },
            { name: "느티나무 공방 : 도끼", chance: 20000, color: "#330033", effect: "blackHole" },
            { name: "로직 아틀리에 : 샷건", chance: 20000, color: "#aaaaaa", effect: "orbitDots" },
            { name: "로직 아틀리에 : 권총", chance: 20000, color: "#ff9933", effect: "goldRune" },
            { name: "올드보이 공방 : 해머", chance: 20000, color: "#66ff66", effect: "cyberGlitch" },
            { name: "알라스 공방 : 랜스", chance: 20000, color: "#aaffff", effect: "iceAura" },
            { name: "휠스 인더스트리 : 대검", chance: 120000, color: "#ff4400", effect: "sunExplosion" },
            { name: "랑아 공방 : 건틀렛", chance: 20000, color: "#ffff88", effect: "starMeteor" },
            { name: "크리스탈 아틀리에 : 쌍검", chance: 20000, color: "#00ffff", effect: "crystalShard" },
            { name: "묵 공방 : 태도", chance: 20000, color: "#ff00ff", effect: "lightningSpark" },
            { name: "뒤랑달", chance: 100000, color: "#ff0055", effect: "darkBloodPillar" },
            { name: "머리 : 발톱", chance: 3000000, color: "#aa0000", effect: "demonHellfire" },
            { name: "특색", chance: 20000, color: "#ffd700", effect: "goldRune" },
            { name: "Golden Bough", chance: 15000000, color: "#ffffaa", effect: "solarCrown" },
            { name: "Roland", chance: 40000000, color: "#ffffff", effect: "rainbowPrism" },
            { name: "Carmen", chance: 100000000, color: "#cc0000", effect: "absoluteRedStorm" },
            { name: "Seed of Light", chance: 300000000, color: "#ffffff", effect: "whiteGodLight" },
            { name: "크아악 롤랑", chance: 1000000000, color: "#00ffff", effect: "galaxyBigBang" }
        ];

        let totalRolls = 0, gold = 0, luck = 1.0, autoDelay = 250;
        let bestChance = 0, bestName = "None", isAuto = false, isRolling = false;
        let activeBuff = null;
        let lastRolledAura = AURAS[0];
        const inventory = {};

        const rollBtn = document.getElementById('roll-btn');
        const autoBtn = document.getElementById('auto-btn');
        const shopBtn = document.getElementById('shop-btn');
        const invBtn = document.getElementById('inv-btn');
        const invModal = document.getElementById('inv-modal');
        const shopModal = document.getElementById('shop-modal');
        const closeInv = document.getElementById('close-inv');
        const closeShop = document.getElementById('close-shop');

        const normalPanel = document.getElementById('normal-panel');
        const inspectPanel = document.getElementById('inspect-panel');
        const exitInspectBtn = document.getElementById('exit-inspect-btn');

        const auraNameEl = document.getElementById('aura-name');
        const auraRarityEl = document.getElementById('aura-rarity');
        const totalRollsEl = document.getElementById('total-rolls');
        const goldValEl = document.getElementById('gold-val');
        const luckMultEl = document.getElementById('luck-mult');
        const bestRollEl = document.getElementById('best-roll');
        const avatar = document.getElementById('character-avatar');

        const canvas = document.getElementById('auraCanvas');
        const ctx = canvas.getContext('2d');
        const particles = [];
        let currentAura = AURAS[0];

        function saveData() {
            const data = { totalRolls, gold, bestChance, bestName, inventory };
            localStorage.setItem('sols_rng_pm_save', JSON.stringify(data));
        }

        function loadData() {
            const saved = localStorage.getItem('sols_rng_pm_save');
            if (saved) {
                try {
                    const data = JSON.parse(saved);
                    totalRolls = data.totalRolls || 0;
                    gold = data.gold || 0;
                    bestChance = data.bestChance || 0;
                    bestName = data.bestName || "None";
                    Object.assign(inventory, data.inventory || {});

                    totalRollsEl.innerText = totalRolls.toLocaleString();
                    goldValEl.innerText = gold.toLocaleString();
                    if (bestChance > 0) {
                        bestRollEl.innerText = `${bestName} (1/${bestChance.toLocaleString()})`;
                        const bestAura = AURAS.find(a => a.name === bestName);
                        if (bestAura) bestRollEl.style.color = bestAura.color;
                    }
                } catch(e) {}
            }
        }

        function roll() {
            if (isRolling) return;
            isRolling = true;
            rollBtn.disabled = true;

            totalRolls++;
            totalRollsEl.innerText = totalRolls.toLocaleString();

            let rollCount = 0;
            const rollInterval = setInterval(() => {
                const tempAura = AURAS[Math.floor(Math.random() * 6)];
                auraNameEl.innerText = tempAura.name;
                auraNameEl.style.color = tempAura.color;
                auraRarityEl.innerText = `1 / ${tempAura.chance.toLocaleString()}`;
                rollCount++;

                if (rollCount > 7) {
                    clearInterval(rollInterval);
                    finalizeRoll();
                }
            }, 45);
        }

        function finalizeRoll() {
            let selectedAura = AURAS[0];
            for (let i = AURAS.length - 1; i >= 0; i--) {
                const effectiveChance = AURAS[i].chance / luck;
                if (Math.random() < (1 / effectiveChance)) {
                    selectedAura = AURAS[i];
                    break;
                }
            }

            const earnedGold = Math.max(1, Math.floor(Math.log2(selectedAura.chance)));
            gold += earnedGold;
            goldValEl.innerText = gold.toLocaleString();

            auraNameEl.innerText = selectedAura.name;
            auraNameEl.style.color = selectedAura.color;
            auraNameEl.style.transform = "scale(1.2)";
            setTimeout(() => auraNameEl.style.transform = "scale(1)", 150);
            auraRarityEl.innerText = `1 / ${selectedAura.chance.toLocaleString()}`;

            currentAura = selectedAura;
            lastRolledAura = selectedAura;
            avatar.style.backgroundColor = selectedAura.color;
            avatar.style.boxShadow = `0 0 35px ${selectedAura.color}`;

            inventory[selectedAura.name] = (inventory[selectedAura.name] || 0) + 1;

            if (selectedAura.chance > bestChance) {
                bestChance = selectedAura.chance;
                bestName = selectedAura.name;
                bestRollEl.innerText = `${bestName} (1/${bestChance.toLocaleString()})`;
                bestRollEl.style.color = selectedAura.color;
            }

            saveData();

            setTimeout(() => {
                isRolling = false;
                rollBtn.disabled = false;
                if (isAuto) setTimeout(roll, autoDelay);
            }, 250);
        }

        function inspectAura(auraName) {
            const foundAura = AURAS.find(a => a.name === auraName);
            if (!foundAura) return;

            currentAura = foundAura;
            auraNameEl.innerText = foundAura.name;
            auraNameEl.style.color = foundAura.color;
            auraRarityEl.innerText = `1 / ${foundAura.chance.toLocaleString()} (관전 모드)`;
            avatar.style.backgroundColor = foundAura.color;
            avatar.style.boxShadow = `0 0 35px ${foundAura.color}`;

            invModal.style.display = 'none';
            normalPanel.style.display = 'none';
            inspectPanel.style.display = 'flex';
        }

        exitInspectBtn.addEventListener('click', () => {
            currentAura = lastRolledAura;
            auraNameEl.innerText = lastRolledAura.name;
            auraNameEl.style.color = lastRolledAura.color;
            auraRarityEl.innerText = `1 / ${lastRolledAura.chance.toLocaleString()}`;
            avatar.style.backgroundColor = lastRolledAura.color;
            avatar.style.boxShadow = `0 0 35px ${lastRolledAura.color}`;

            inspectPanel.style.display = 'none';
            normalPanel.style.display = 'flex';
        });

        let angleTick = 0;

        function renderCanvas() {
            ctx.clearRect(0, 0, 500, 500);
            const centerX = 250, centerY = 250;
            angleTick += 0.03;

            const color = currentAura.color;
            const effect = currentAura.effect;

            const grad = ctx.createRadialGradient(centerX, centerY, 20, centerX, centerY, 180);
            grad.addColorStop(0, color + 'aa');
            grad.addColorStop(1, 'transparent');
            ctx.fillStyle = grad;
            ctx.beginPath();
            ctx.arc(centerX, centerY, 180, 0, Math.PI * 2);
            ctx.fill();

            if (effect === 'fireFlame' || effect === 'demonHellfire' || effect === 'darkBloodPillar') {
                if (Math.random() < 0.6) {
                    particles.push({
                        x: centerX + (Math.random() - 0.5) * 80, y: centerY + 40,
                        vx: (Math.random() - 0.5) * 2, vy: -Math.random() * 4 - 2,
                        size: Math.random() * 8 + 4, life: 1, color
                    });
                }
            } else if (effect === 'swirlVortex' || effect === 'cosmicRings' || effect === 'rainbowPrism') {
                ctx.strokeStyle = color; ctx.lineWidth = 3;
                ctx.beginPath();
                ctx.arc(centerX, centerY, 90 + Math.sin(angleTick) * 10, angleTick, angleTick + Math.PI * 1.5);
                ctx.stroke();
                ctx.beginPath();
                ctx.arc(centerX, centerY, 130 + Math.cos(angleTick) * 10, -angleTick, -angleTick + Math.PI * 1.2);
                ctx.stroke();
            } else if (effect === 'cyberGlitch' || effect === 'pixelNoise') {
                if (Math.random() < 0.4) {
                    ctx.fillStyle = Math.random() < 0.5 ? '#00ff66' : '#ff00ff';
                    ctx.fillRect(centerX + (Math.random() - 0.5) * 200, centerY + (Math.random() - 0.5) * 200, Math.random() * 20 + 5, 4);
                }
            } else if (effect === 'lightningSpark' || effect === 'absoluteRedStorm') {
                ctx.strokeStyle = color; ctx.lineWidth = 2;
                for (let i = 0; i < 3; i++) {
                    ctx.beginPath();
                    ctx.moveTo(centerX, centerY);
                    ctx.lineTo(centerX + (Math.random() - 0.5) * 240, centerY + (Math.random() - 0.5) * 240);
                    ctx.stroke();
                }
            } else if (effect === 'galaxyBigBang' || effect === 'whiteGodLight' || effect === 'blackHole') {
                ctx.strokeStyle = color; ctx.lineWidth = 4;
                ctx.beginPath();
                ctx.arc(centerX, centerY, 150 + Math.sin(angleTick * 2) * 20, 0, Math.PI * 2);
                ctx.stroke();
            }

            if (Math.random() < 0.3) {
                particles.push({
                    x: centerX + Math.cos(angleTick * 2) * 100, y: centerY + Math.sin(angleTick * 2) * 100,
                    vx: (Math.random() - 0.5) * 2, vy: (Math.random() - 0.5) * 2,
                    size: Math.random() * 6 + 3, life: 1, color
                });
            }

            for (let i = particles.length - 1; i >= 0; i--) {
                const p = particles[i];
                p.x += p.vx; p.y += p.vy; p.life -= 0.02;
                ctx.fillStyle = p.color;
                ctx.globalAlpha = Math.max(0, p.life);
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                ctx.fill();
                if (p.life <= 0) particles.splice(i, 1);
            }
            ctx.globalAlpha = 1.0;

            requestAnimationFrame(renderCanvas);
        }

        function applyBuff(luckMult, speedMult, duration) {
            if (activeBuff) clearInterval(activeBuff);
            luck = luckMult; autoDelay = 250 / speedMult;
            luckMultEl.innerText = `${luckMult}x (공명 중!)`; luckMultEl.style.color = "#ffaa00";

            let timer = duration;
            activeBuff = setInterval(() => {
                timer--;
                if (timer <= 0) {
                    clearInterval(activeBuff);
                    luck = 1.0; autoDelay = 250;
                    luckMultEl.innerText = "1.0x"; luckMultEl.style.color = "#00ffcc";
                    activeBuff = null;
                }
            }, 1000);
        }

        function buyPotion(type) {
            if (type === 'small') {
                if (gold < 100) { alert('안젤리카의 유산(G)이 부족합니다!'); return; }
                gold -= 100; goldValEl.innerText = gold.toLocaleString();
                saveData();
                applyBuff(2.0, 1.0, 15);
            }
        }

        function craftPotion(type) {
            if (type === 'large') {
                if (gold < 500 || !(inventory['TETH: 단악수선'] >= 1)) { alert('재료 부족! (단악수선 1개 필요)'); return; }
                gold -= 500; inventory['TETH: 단악수선']--; goldValEl.innerText = gold.toLocaleString();
                saveData();
                applyBuff(5.0, 1.0, 20);
            } else if (type === 'speed') {
                if (gold < 1000 || !(inventory['HE: 눈의 여왕'] >= 1)) { alert('재료 부족! (눈의 여왕 1개 필요)'); return; }
                gold -= 1000; inventory['HE: 눈의 여왕']--; goldValEl.innerText = gold.toLocaleString();
                saveData();
                applyBuff(1.0, 3.0, 20);
            } else if (type === 'hyper') {
                if (gold < 5000 || !(inventory['HE: 알리우네'] >= 1)) { alert('재료 부족! (알리우네 1개 필요)'); return; }
                gold -= 5000; inventory['HE: 알리우네']--; goldValEl.innerText = gold.toLocaleString();
                saveData();
                applyBuff(20.0, 1.0, 10);
            }
        }

        rollBtn.addEventListener('click', roll);
        window.addEventListener('keydown', (e) => {
            if (e.code === 'Space' && !isRolling && document.activeElement.tagName !== 'BUTTON') roll();
        });

        autoBtn.addEventListener('click', () => {
            isAuto = !isAuto;
            if (isAuto) {
                autoBtn.innerText = "Auto: ON"; autoBtn.classList.add('active');
                if (!isRolling) roll();
            } else {
                autoBtn.innerText = "Auto: OFF"; autoBtn.classList.remove('active');
            }
        });

        invBtn.addEventListener('click', () => {
            const listEl = document.getElementById('inv-list');
            listEl.innerHTML = '';
            AURAS.forEach(a => {
                const count = inventory[a.name] || 0;
                const row = document.createElement('div');
                row.className = 'item-row';
                
                const viewBtnHtml = count > 0 
                    ? `<button class="view-btn" onclick="inspectAura('${a.name}')">👁️ 구경</button>` 
                    : `<span style="color:#666; font-size:12px;">미해금</span>`;

                row.innerHTML = `
                    <div>
                        <span style="color:${a.color}; font-weight:bold;">${a.name} (1/${a.chance.toLocaleString()})</span>
                        <div style="font-size:12px; color:#aaa;">보유: ${count}개</div>
                    </div>
                    ${viewBtnHtml}
                `;
                listEl.appendChild(row);
            });
            invModal.style.display = 'flex';
        });

        shopBtn.addEventListener('click', () => shopModal.style.display = 'flex');
        closeInv.addEventListener('click', () => invModal.style.display = 'none');
        closeShop.addEventListener('click', () => shopModal.style.display = 'none');

        loadData();
        renderCanvas();
    </script>
</body>
</html>
